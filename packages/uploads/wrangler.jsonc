{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "agent-tools-uploads",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "PUBLIC_ORIGIN": "https://uploads.example.com",
    "WEBHOOK_ORIGINS": ""
  },
  "secrets": { "required": ["API_TOKEN"] },
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "agent-tools-uploads" }],
  "durable_objects": {
    "bindings": [{ "name": "UPLOADS", "class_name": "Upload" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Upload"] }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "head_sampling_rate": 1
    }
  }
}
